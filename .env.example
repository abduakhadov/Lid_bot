# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadbot_db

# Operator Telegram Group
OPERATOR_GROUP_ID=-1001234567890

# Google Sheets
GOOGLE_SHEET_NAME=Leads
GOOGLE_CREDENTIALS_FILE=credentials.json

# Bot Admins (vergul bilan ajratilgan telegram id lar)
ADMIN_IDS=123456789,987654321

# Rate limit (sekundda nechta xabar)
RATE_LIMIT=1.0
